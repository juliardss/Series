<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.template.MainController">
   <children>
      <Pane prefHeight="510.0" prefWidth="736.0" style="-fx-background-color: #1F4E79;">
         <children>
            <Label layoutX="308.0" layoutY="21.0" prefHeight="35.0" prefWidth="155.0" text="CRUD SÉRIES" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <TableView fx:id="tblSerie" layoutX="203.0" layoutY="348.0" onMouseClicked="#carregarCampos" prefHeight="138.0" prefWidth="365.0" style="-fx-background-color: F5F7FA; -fx-border-color: #D0D7DE; -fx-border-width: 1;">
              <columns>
                <TableColumn fx:id="colId" prefWidth="49.0" text="id" />
                <TableColumn fx:id="colNome" prefWidth="66.0" text="nome" />
                  <TableColumn fx:id="colGenero" prefWidth="67.0" text="genero" />
                  <TableColumn fx:id="colAnoLancamento" prefWidth="98.0" text="ano_lancamento" />
                  <TableColumn fx:id="colPlataforma" prefWidth="86.0" text="plataforma" />
              </columns>
            </TableView>
            <VBox layoutX="551.0" layoutY="125.0" prefHeight="107.0" prefWidth="85.0" style="-fx-alignment: center; -fx-spacing: 10;">
               <children>
                  <Button fx:id="btnSalvar" mnemonicParsing="false" onAction="#btnSalvarAction" prefHeight="25.0" prefWidth="119.0" style="-fx-background-color: #4F81BD; -fx-text-fill: white; -fx-background-radius: 5; -fx-font-weight: bold;" text="Salvar" />
                  <Button fx:id="btnAtualizar" mnemonicParsing="false" onAction="#btnAtualizarAction" prefHeight="25.0" prefWidth="99.0" style="-fx-background-color: #4F81BD; -fx-background-radius: 5;" text="Atualizar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                  <Button fx:id="btnDeletar" mnemonicParsing="false" onAction="#btnDeletarAction" prefHeight="25.0" prefWidth="101.0" style="-fx-background-color: #4F81BD;" text="Deletar" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font></Button>
                  <Button fx:id="btnLimpar" mnemonicParsing="false" onAction="#btnLimparAction" prefHeight="25.0" prefWidth="94.0" style="-fx-background-color: #4F81BD;" text="Limpar" textFill="WHITE" />
               </children>
            </VBox>
            <GridPane layoutX="216.0" layoutY="83.0" prefHeight="214.0" prefWidth="260.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                  <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  <TextField fx:id="txtId" disable="true" focusTraversable="false" GridPane.columnIndex="1" />
                  <TextField fx:id="txtNome" style="-fx-background-color: white; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: B0BEC5; -fx-border-width: 1;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <TextField fx:id="txtGenero" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <TextField fx:id="txtAnoLancamento" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <TextField fx:id="txtPlataforma" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                  <Label text="Id" textFill="WHITE">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Nome" textFill="WHITE" GridPane.rowIndex="1">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Gênero" textFill="WHITE" GridPane.rowIndex="2">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Ano de lançamento" textFill="WHITE" GridPane.rowIndex="3">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <Label text="Plataforma" textFill="WHITE" GridPane.rowIndex="4">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
               </children>
            </GridPane>
         </children>
      </Pane>
   </children>
</AnchorPane>
